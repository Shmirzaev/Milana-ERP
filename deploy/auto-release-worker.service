[Unit]
Description=Milana fixed GitHub release worker (no builds or workflow execution)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=milana-deploy
Group=milana-deploy
ExecStart=/usr/bin/python3 -E -s /opt/milana-auto-release/auto_release_worker.py
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/milana-auto-release
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
