DATABASE_URL=postgresql+psycopg2://erp:erp@db:5432/erp
JWT_SECRET=change-me-to-a-unique-32-plus-character-secret
FILE_SIGNING_SECRET=change-me-to-a-different-32-plus-character-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-unique-admin-password
SEED_DEMO_USERS=false
SEED_SAMPLE_DATA=false
IMPORT_LEGACY_MODELS=false
ALLOW_INSECURE_DEFAULT_ADMIN_LOGIN=false
ALLOW_DEMO_RESET=false
APP_NAME=Milana ERP
ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000
BARCODE_STORAGE_DIR=/app/storage/barcodes
MODEL_FILES_DIR=/app/storage/model_files
SALES_ORDER_FILES_DIR=/app/storage/sales_order_files
INTEGRATION_1C_TOKEN=change-me-to-a-unique-1c-token
